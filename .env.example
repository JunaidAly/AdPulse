# AdPulse frontend — Firebase web config (PUBLIC, non-secret).
#
# Copy this file to `.env` and fill in the values from the Firebase
# Console → Project settings → General → "Your apps" → SDK setup.
# Do NOT commit `.env` (it is gitignored).
#
# Project: adpulse1234 (region asia-south1)

VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=adpulse1234.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=adpulse1234
VITE_FIREBASE_STORAGE_BUCKET=adpulse1234.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=397161801276
VITE_FIREBASE_APP_ID=your-web-app-id
